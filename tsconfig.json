{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false
  },
  "include": [
    "declarations.d.ts",
    "*.tsx",
    "*.ts",
    "*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
